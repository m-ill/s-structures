{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-structures.local/schemas/phase17/tolerance-manifest-schema.json",
  "title": "Phase 17 tolerance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "status", "payloadAbsent", "releaseAllowed", "policy", "criteria", "approval", "reasonCodes"],
  "properties": {
    "schemaVersion": { "const": "p17-tolerance-manifest-v1" },
    "caseId": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "status": { "enum": ["NOT_LOCKED", "LOCKED"] },
    "payloadAbsent": { "type": "boolean" },
    "releaseAllowed": { "type": "boolean" },
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["signedComparisonDefault", "nearZeroPolicy", "postResultTuningAllowed"],
      "properties": { "signedComparisonDefault": { "const": true }, "nearZeroPolicy": { "enum": ["NOT_LOCKED", "ABSOLUTE_TOLERANCE"] }, "postResultTuningAllowed": { "const": false } }
    },
    "criteria": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metricId", "comparisonMode", "relativeTolerancePct", "absoluteTolerance", "nearZeroThreshold", "unit", "mandatory", "approvalHash"],
        "properties": {
          "metricId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }, "comparisonMode": { "enum": ["SIGNED_RELATIVE", "SIGNED_ABSOLUTE", "UNSIGNED_ABSOLUTE"] },
          "relativeTolerancePct": { "type": ["number", "null"], "minimum": 0 }, "absoluteTolerance": { "type": ["number", "null"], "minimum": 0 },
          "nearZeroThreshold": { "type": "number", "minimum": 0 }, "unit": { "type": "string", "minLength": 1 }, "mandatory": { "type": "boolean" },
          "approvalHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "approval": { "type": "object", "additionalProperties": false, "required": ["status", "reviewer", "approvalHash"], "properties": { "status": { "enum": ["NOT_STARTED", "PENDING", "APPROVED"] }, "reviewer": { "type": "string", "minLength": 1 }, "approvalHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" } } },
    "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" } }
  }
}
