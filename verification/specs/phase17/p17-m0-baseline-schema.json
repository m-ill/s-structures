{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-structures.local/schemas/phase17/p17-m0-baseline-schema.json",
  "title": "Phase 17 M0 baseline and source-lock evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "phase",
    "milestone",
    "auditDate",
    "sourceRevision",
    "status",
    "m1EntryAllowed",
    "releaseAllowed",
    "finalDesignTransferAllowed",
    "sourceCustody",
    "phase15HistoricalSnapshot",
    "artifacts",
    "gates",
    "blockers",
    "baselineHash"
  ],
  "properties": {
    "version": { "const": "p17-m0-baseline-source-lock-v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "type": ["object", "null"], "additionalProperties": true },
    "phase": { "const": 17 },
    "milestone": { "const": "P17-M0" },
    "auditDate": { "type": "string", "format": "date" },
    "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": { "enum": ["NOT_STARTED", "IN_PROGRESS", "BLOCKED", "COMPLETE", "COMPLETE_WITH_SOURCE_BLOCKERS"] },
    "m1EntryAllowed": { "type": "boolean" },
    "releaseAllowed": { "const": false },
    "finalDesignTransferAllowed": { "const": false },
    "phase17InheritedPassCount": { "const": 0 },
    "externalRuntimeUsed": { "const": false },
    "strixActualR4Used": { "const": false },
    "midasActualR4Used": { "const": false },
    "sourceCustody": { "type": "object", "additionalProperties": true },
    "phase15HistoricalSnapshot": { "type": "object", "additionalProperties": true },
    "artifacts": { "type": "object", "additionalProperties": true },
    "gates": { "type": "array", "minItems": 1 },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "baselineHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
