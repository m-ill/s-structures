{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-structures.local/schemas/phase17/suite-source-registry-schema.json",
  "title": "Phase 17 STRIX 21 source registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "phase",
    "milestone",
    "officialCaseCount",
    "officialOrder",
    "customExcluded",
    "sourceBundle",
    "authorityPolicy",
    "claimVocabulary",
    "approvalRoles",
    "cases",
    "registryHash"
  ],
  "properties": {
    "version": { "const": "p17-suite-source-registry-v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "type": ["object", "null"], "additionalProperties": true },
    "phase": { "const": 17 },
    "milestone": { "const": "P17-M0" },
    "auditDate": { "type": "string", "format": "date" },
    "sourceRoot": { "type": "string", "minLength": 1 },
    "originalUrl": { "type": "string", "format": "uri" },
    "officialCaseCount": { "const": 21 },
    "officialOrder": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "catalogOrder": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "customExcluded": { "type": "array", "minItems": 1 },
    "sourceBundle": { "type": "object", "additionalProperties": true },
    "authorityPolicy": { "type": "object", "additionalProperties": true },
    "claimVocabulary": { "type": "object", "additionalProperties": true },
    "approvalRoles": { "type": "array", "minItems": 5 },
    "cases": { "type": "array", "minItems": 21, "maxItems": 21 },
    "registryHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
