{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-structures.local/schemas/phase17/replay-audit-schema.json",
  "title": "Phase 17 deterministic replay audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "caseId", "runId", "auditKind", "status", "sourceArtifacts", "replayHash", "reasonCodes", "auditHash"],
  "properties": {
    "version": { "const": "p17-replay-audit-v1" },
    "caseId": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "runId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{7,127}$" },
    "auditKind": { "enum": ["REFERENCE_BYTES", "EXTRACTION_COMPARISON", "PHYSICS_MUTATION", "PDF_VISUAL_PARITY"] },
    "status": { "enum": ["PASS", "FAIL", "PENDING", "BLOCKED"] },
    "sourceArtifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "byteLength", "sha256", "status"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "byteLength": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "enum": ["PASS", "FAIL"] }
        }
      }
    },
    "replayHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" } },
    "auditHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
