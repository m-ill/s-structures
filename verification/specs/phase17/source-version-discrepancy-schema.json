{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-structures.local/schemas/phase17/source-version-discrepancy-schema.json",
  "title": "Phase 17 source discrepancy register",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "phase", "milestone", "items", "registerHash"],
  "properties": {
    "version": { "const": "p17-source-discrepancy-register-v1" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes": { "type": ["object", "null"], "additionalProperties": true },
    "phase": { "const": 17 },
    "milestone": { "const": "P17-M0" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "status", "title", "affectedCases", "evidence", "disposition", "releaseImpact"],
        "additionalProperties": true
      }
    },
    "registerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
