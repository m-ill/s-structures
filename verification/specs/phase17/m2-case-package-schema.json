{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s-structures.local/schemas/phase17/m2-case-package-schema.json",
  "title": "P17-M2 SB1 append-only case package revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "phase", "milestone", "caseId", "revision", "status", "baseScaffoldBinding", "artifacts", "lockStates", "gateAssessmentHash", "counters", "reasonCodes", "releaseAllowed", "packageHash"],
  "properties": {
    "version": { "const": "p17-m2-sb1-case-package-v1" },
    "phase": { "const": 17 },
    "milestone": { "const": "P17-M2" },
    "caseId": { "const": "SB1" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["CONTENT_LOCKED_PENDING_EXTERNAL_APPROVAL", "READY_FOR_OFFICIAL_EXECUTION", "EXECUTED_PENDING_TERMINAL_EVIDENCE", "PASS", "FAIL", "BLOCKED_QUALIFICATION"] },
    "baseScaffoldBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "canonicalHash", "sha256", "byteLength"],
      "properties": {
        "path": { "const": "verification/benchmarks/strix21/cases/SB1/case-manifest.json" },
        "canonicalHash": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "canonicalHash", "sha256", "byteLength"],
        "properties": {
          "role": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "path": { "type": "string", "minLength": 1 },
          "canonicalHash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "byteLength": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "lockStates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference", "probe", "tolerance", "canonicalModel", "nativeModel", "modelEquivalence", "productBuild"],
      "properties": {
        "source": { "$ref": "#/$defs/lockState" },
        "reference": { "$ref": "#/$defs/lockState" },
        "probe": { "$ref": "#/$defs/lockState" },
        "tolerance": { "$ref": "#/$defs/lockState" },
        "canonicalModel": { "$ref": "#/$defs/lockState" },
        "nativeModel": { "$ref": "#/$defs/lockState" },
        "modelEquivalence": { "$ref": "#/$defs/lockState" },
        "productBuild": { "$ref": "#/$defs/lockState" }
      }
    },
    "gateAssessmentHash": { "$ref": "#/$defs/sha256" },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["officialExecutionCount", "solverExecutionCount", "benchmarkExecutionCount", "engineeringResultCount", "caseReportCount", "officialPassCount"],
      "properties": {
        "officialExecutionCount": { "const": 0 },
        "solverExecutionCount": { "const": 0 },
        "benchmarkExecutionCount": { "const": 0 },
        "engineeringResultCount": { "const": 0 },
        "caseReportCount": { "const": 0 },
        "officialPassCount": { "const": 0 }
      }
    },
    "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" } },
    "releaseAllowed": { "const": false },
    "packageHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lockState": { "enum": ["CONTENT_LOCKED_PENDING_EXTERNAL_APPROVAL", "APPROVED"] }
  }
}
