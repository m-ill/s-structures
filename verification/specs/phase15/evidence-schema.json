{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s-structures://phase15/evidence-schema-v1",
  "title": "S-Structures Phase 15 qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "caseId",
    "specVersion",
    "claimScope",
    "executionStatus",
    "status",
    "reasonCodes",
    "staleReasons",
    "calculation",
    "result",
    "metrics",
    "mandatoryGates",
    "reviews",
    "run",
    "releaseAllowed",
    "designTransferAllowed",
    "evidenceHash"
  ],
  "properties": {
    "version": { "const": "p15-evidence-artifact-v1" },
    "caseId": { "type": "string", "minLength": 1 },
    "specVersion": { "type": "string", "minLength": 1 },
    "claimScope": { "type": "string", "minLength": 1 },
    "executionStatus": {
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE", "INVALIDATED", "SELF_TEST", "PARTIAL", "TIMEOUT", "ERROR"]
    },
    "status": {
      "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "NOT_APPLICABLE", "INVALIDATED", "SELF_TEST"]
    },
    "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "staleReasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "calculation": { "$ref": "#/$defs/calculation" },
    "result": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/result" }] },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
    "mandatoryGates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
    "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" } },
    "run": { "$ref": "#/$defs/run" },
    "releaseAllowed": { "const": false },
    "designTransferAllowed": { "const": false },
    "evidenceHash": { "$ref": "#/$defs/hash" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "result": { "$ref": "#/$defs/result" },
          "staleReasons": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceHash", "buildHash", "modelHash", "inputHash", "solverSettingsHash", "referenceHash", "toleranceHash", "probeHash"],
      "properties": {
        "sourceHash": { "$ref": "#/$defs/hash" },
        "buildHash": { "$ref": "#/$defs/hash" },
        "modelHash": { "$ref": "#/$defs/hash" },
        "inputHash": { "$ref": "#/$defs/hash" },
        "solverSettingsHash": { "$ref": "#/$defs/hash" },
        "referenceHash": { "$ref": "#/$defs/hash" },
        "toleranceHash": { "$ref": "#/$defs/hash" },
        "probeHash": { "$ref": "#/$defs/hash" }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "specVersion", "claimScope", "binding", "calculationHash"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "specVersion": { "type": "string", "minLength": 1 },
        "claimScope": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/binding" },
        "calculationHash": { "$ref": "#/$defs/hash" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calculationHash", "payload", "solverDiagnostics", "audits", "convergenceHistory", "resultHash"],
      "properties": {
        "calculationHash": { "$ref": "#/$defs/hash" },
        "payload": { "type": ["object", "array"], "minProperties": 1, "minItems": 1 },
        "solverDiagnostics": { "type": "object", "minProperties": 1 },
        "audits": { "type": "object", "minProperties": 1 },
        "convergenceHistory": { "type": "array", "minItems": 1 },
        "resultHash": { "$ref": "#/$defs/hash" }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "probeId", "quantity", "unit", "axis", "signConvention", "referenceHash", "toleranceHash", "probeHash", "metricType", "magnitudeMeaning", "approvedBy", "magnitudeApprovalHash", "actual", "reference", "comparedActual", "comparedReference", "signedDifference", "absoluteError", "relativeError", "relativeScale", "relativeTolerance", "absoluteTolerance", "characteristicFloor", "comparisonPolicy", "status", "passed", "metricHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "probeId": { "type": "string", "minLength": 1 },
        "quantity": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "axis": { "type": "string", "minLength": 1 },
        "signConvention": { "type": "string", "minLength": 1 },
        "referenceHash": { "$ref": "#/$defs/hash" },
        "toleranceHash": { "$ref": "#/$defs/hash" },
        "probeHash": { "$ref": "#/$defs/hash" },
        "metricType": { "enum": ["signed", "magnitude"] },
        "magnitudeMeaning": { "type": ["string", "null"] },
        "approvedBy": { "type": ["string", "null"] },
        "magnitudeApprovalHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
        "actual": { "type": "number" },
        "reference": { "type": "number" },
        "comparedActual": { "type": "number" },
        "comparedReference": { "type": "number" },
        "signedDifference": { "type": "number" },
        "absoluteError": { "type": "number", "minimum": 0 },
        "relativeError": { "type": ["number", "null"], "minimum": 0 },
        "relativeScale": { "type": "number", "minimum": 0 },
        "relativeTolerance": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "absoluteTolerance": { "type": ["number", "null"], "minimum": 0 },
        "characteristicFloor": { "type": "number", "minimum": 0 },
        "comparisonPolicy": { "enum": ["absolute-or-relative", "absolute-only", "relative-only"] },
        "status": { "enum": ["PASS", "FAIL"] },
        "passed": { "type": "boolean" },
        "metricHash": { "$ref": "#/$defs/hash" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "mandatory", "reasonCode", "details", "gateHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "INVALIDATED"] },
        "mandatory": { "type": "boolean" },
        "reasonCode": { "type": "string", "minLength": 1 },
        "details": { "type": ["string", "null"] },
        "gateHash": { "$ref": "#/$defs/hash" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "reviewer", "status", "required", "approvalHash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "reviewer": { "type": "string", "minLength": 1 },
        "status": { "enum": ["APPROVED", "REJECTED", "PENDING"] },
        "required": { "type": "boolean" },
        "approvalHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calculationHash", "resultHash", "startedAt", "completedAt", "environment", "runId", "runRecordHash"],
      "properties": {
        "calculationHash": { "$ref": "#/$defs/hash" },
        "resultHash": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "environment": { "type": "object", "minProperties": 1 },
        "runId": { "type": ["string", "null"] },
        "runRecordHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
